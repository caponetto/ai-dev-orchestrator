{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["playwright"],
  "ignoreWorkspaces": ["packages/dashboard"],
  "workspaces": {
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/workflow": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/dashboard-server": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/governance": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/policy-engine": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/role-system": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/build-config": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["write-file-atomic"]
    },
    "packages/prompt-engine": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@types/diff"]
    }
  }
}
