{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "globalEnv": ["NODE_ENV", "CI"],
  "boundaries": {
    "tags": {
      "foundation": {
        "dependencies": {
          "deny": [
            "contracts",
            "domain",
            "infrastructure",
            "orchestration",
            "application",
            "composition"
          ]
        }
      },
      "contracts": {
        "dependencies": {
          "deny": ["domain", "infrastructure", "orchestration", "application", "composition"]
        }
      },
      "domain": {
        "dependencies": {
          "deny": ["infrastructure", "orchestration", "application", "composition"]
        }
      },
      "infrastructure": {
        "dependencies": {
          "deny": ["orchestration", "application", "composition"]
        }
      },
      "orchestration": {
        "dependencies": {
          "deny": ["application", "composition"]
        }
      },
      "application": {
        "dependencies": {
          "deny": ["composition"]
        }
      }
    }
  },
  "tasks": {
    "clean": {
      "cache": false
    },
    "//#format:check:run": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#syncpack:check:run": {
      "inputs": ["package.json", "packages/**/package.json", "pnpm-lock.yaml"],
      "outputs": []
    },
    "//#publint:run": {
      "inputs": ["package.json", "packages/**/package.json", "pnpm-lock.yaml"],
      "outputs": []
    },
    "//#knip:run": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#typecheck:scripts:run": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "tsconfig.base.json", "scripts/**/*.ts"],
      "outputs": []
    },
    "//#test:scripts:run": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.base.json",
        "vitest.scripts.config.ts",
        "scripts/**/*.ts"
      ],
      "outputs": ["coverage-scripts/**", "test-report.scripts.junit.xml"]
    },
    "//#lint:scripts:run": {
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*", "scripts/**/*.ts"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["build:dev"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*", "../../eslint.config.*"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build:dev"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["typecheck"],
      "outputs": ["coverage/**", "test-report.unit.junit.xml", ".vitest-reports/**"],
      "inputs": ["src/**", "test/**", "vitest.config.*"]
    },
    "test:e2e": {
      "dependsOn": ["^build:dev"],
      "inputs": ["src/**", "e2e/**", "playwright.config.*"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:integration": {
      "dependsOn": ["typecheck"],
      "inputs": ["src/**", "test/**", "vitest.*.config.*"],
      "outputs": [
        "test-report.integration.junit.xml",
        "coverage-integration/**",
        ".vitest-reports/**"
      ]
    },
    "build:dev": {
      "dependsOn": ["^build:dev", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"],
      "outputs": ["dist/**"]
    },
    "build:prod": {
      "dependsOn": ["^build:prod"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"],
      "outputs": ["dist/**"]
    }
  }
}
