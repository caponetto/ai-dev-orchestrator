{
  "name": "@ai-dev-orchestrator/cli",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caponetto/ai-dev-orchestrator.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-dev-orchestrator/agent-adapters": "workspace:*",
    "@ai-dev-orchestrator/artifacts": "workspace:*",
    "@ai-dev-orchestrator/config-templates": "workspace:*",
    "@ai-dev-orchestrator/core": "workspace:*",
    "@ai-dev-orchestrator/dashboard-server": "workspace:*",
    "@ai-dev-orchestrator/dependency-graph": "workspace:*",
    "@ai-dev-orchestrator/execution-analytics": "workspace:*",
    "@ai-dev-orchestrator/governance": "workspace:*",
    "@ai-dev-orchestrator/journal": "workspace:*",
    "@ai-dev-orchestrator/policy-engine": "workspace:*",
    "@ai-dev-orchestrator/ports": "workspace:*",
    "@ai-dev-orchestrator/project-context": "workspace:*",
    "@ai-dev-orchestrator/prompt-engine": "workspace:*",
    "@ai-dev-orchestrator/recovery": "workspace:*",
    "@ai-dev-orchestrator/role-system": "workspace:*",
    "@ai-dev-orchestrator/run-manifest": "workspace:*",
    "@ai-dev-orchestrator/runner": "workspace:*",
    "@ai-dev-orchestrator/schemas": "workspace:*",
    "@ai-dev-orchestrator/utils": "workspace:*",
    "@ai-dev-orchestrator/workflow": "workspace:*",
    "commander": "^15.0.0",
    "write-file-atomic": "^8.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ai-dev-orchestrator/build-config": "workspace:*",
    "@ai-dev-orchestrator/dashboard": "workspace:*",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "build:base": "rimraf dist && node esbuild.config.js",
    "build:dev": "NODE_ENV=development pnpm run build:base",
    "build:prod": "pnpm run build:base",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
